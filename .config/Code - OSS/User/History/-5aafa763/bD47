super + Escape
	pkill -USR1 -x sxhkd

super + alt + {q,r}
	bspc {quit,wm -r}

# Программы
super + Return
    alacritty

super + w
    firefox

super + o
    obsidian

super + c
    vscodium 

super + s
    alacritty nvim

super + t
    Telegram

super + q
    bspc node -k

super + e
    thunar

super + @space
    bspc node -t ~floating

super + d
    rofi -show drun

super + j
    bspc node -p east  # togglesplit аналог

# Фокус (arrow keys)
super + {Left,Right,Up,Down}
    bspc node -f {west,east,north,south}

# Workspaces
super + {_,shift + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}'

super + shift + {1-9,0}
    bspc node -d ^{1-10}

# Swap (ALT аналог shift в sxhkd)
super + alt + {Left,Right,Up,Down}
    bspc node -s {west,east,north,south}

# Resize
super + shift + Right
    bspc node -z right +30 0

super + shift + Left
    bspc node -z right -30 0

super + shift + Up
    bspc node -z top 0 -30

super + shift + Down
    bspc node -z top 0 30

# Другие
super + l
    i3lock  # вместо hyprlock

super + p
    grim -g "$(slurp)" - | wl-copy  # X11: scrot -s

super + shift + p
    scrot -u  # region

super + f
    bspc node -t ~floating

XF86Audio{Raise,Lower}Volume
    pamixer -i{d 5} 5

XF86AudioMute
    pamixer -t

XF86Mon{BrightnessUp,Down}
    brightnessctl s +{-}5%

